# Copy this file to server/.env and fill in your own values.
# server/.env is ignored by git, so the real connection string is never
# committed. Never put a password in this example file.

# Connection string for the MongoDB Atlas cluster.
# Get it from Atlas: Cluster -> Connect -> Drivers -> Node.js.
# Replace <password> with the database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster. Optional, defaults to csd_group_chat.
# MONGODB_DB_NAME=csd_group_chat

# Key used to encrypt messages before they are stored: 32 bytes, base64 encoded.
# Generate your own with "npm run generate-key" and paste it here. There is no
# real key in this file on purpose, and the server refuses to start without one.
# Changing the key makes every message already in the database unreadable.
CHAT_ENCRYPTION_KEY=

# Port the chat server listens on. Optional, defaults to 4000.
# The client dev server uses 3000, so avoid that one.
# PORT=4000
