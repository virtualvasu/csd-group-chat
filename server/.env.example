# Copy this file to server/.env and fill in your own values.
# server/.env is ignored by git, so the real connection string is never
# committed. Never put a password in this example file.

# Connection string for the MongoDB Atlas cluster.
# Get it from Atlas: Cluster -> Connect -> Drivers -> Node.js.
# Replace <password> with the database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster. Optional, defaults to csd_group_chat.
# MONGODB_DB_NAME=csd_group_chat

# Port the chat server listens on. Optional, defaults to 3000.
# PORT=3000
