{
  "name": "csd-group-chat-server",
  "version": "1.0.0",
  "description": "Backend server for real-time group chat (WebSockets / Socket.IO)",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env --test",
