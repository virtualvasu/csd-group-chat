    "tamper-demo": "node --env-file-if-exists=.env scripts/tamper-demo.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongodb": "^7.5.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
